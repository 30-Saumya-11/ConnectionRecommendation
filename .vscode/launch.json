{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "1. Run BloodConnect Web App",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/blood_app.py",
            "args": ["web"],
            "console": "integratedTerminal"
        },
        {
            "name": "2. Run All 40 Unit Tests",
            "type": "debugpy",
            "request": "launch",
            "module": "unittest",
            "args": ["discover", "-s", "tests", "-v"],
            "console": "integratedTerminal"
        }
    ]
}
